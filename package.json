{
  "name": "nooki",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:capabilities": "node --test capabilities/*/*.test.ts",
    "test:platform": "node --test tests/*.test.ts",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles app",
    "desktop:build:dmg": "tauri build --bundles dmg",
    "desktop:open": "open src-tauri/target/release/bundle/macos/Nooki.app",
    "desktop:install": "ditto src-tauri/target/release/bundle/macos/Nooki.app /Applications/Nooki.app",
    "desktop:update": "npm run desktop:build && npm run desktop:install",
    "capability:pack": "node scripts/package-capability.mjs",
    "capability:kit": "node scripts/build-capability-kit.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "@tauri-apps/api": "2.11.0",
    "i18next": "26.4.1",
    "motion": "12.40.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.13",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
